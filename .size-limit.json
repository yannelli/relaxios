  { "name": "upload core", "path": "dist/upload.js", "import": "{ upload }", "ignore": [
      "relaxios/progress"
    ], "gzip": true, "limit": "3 kB" },
  { "name": "upload + ietf", "path": "dist/upload.js", "import": "{ upload, ietf }", "ignore": [
      "relaxios/progress"
    ], "gzip": true },
  { "name": "upload + s3Multipart", "path": "dist/upload.js", "import": "{ upload, s3Multipart }", "ignore": [
      "relaxios/progress"
    ], "gzip": true },
  { "name": "upload + xhrSingle", "path": "dist/upload.js", "import": "{ upload, xhrSingle }", "ignore": [
      "relaxios/progress"
    ], "gzip": true },
  { "name": "vue adapter (own code)", "path": "dist/vue.js", "import": "{ useUpload }", "ignore": [
