{
  "name": "relaxios",
  "version": "0.1.1",
  "description": "A TypeScript port of axios 1.20.0 on native fetch, plus a small core client, stream progress and resumable uploads. No dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yannelli/relaxios.git"
  },
  "homepage": "https://github.com/yannelli/relaxios#readme",
  "bugs": {
    "url": "https://github.com/yannelli/relaxios/issues"
  },
  "keywords": [
    "axios",
    "fetch",
    "http",
    "client",
    "progress",
    "upload",
    "resumable",
    "s3",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./axios": {
      "types": "./dist/axios.node.d.ts",
      "bun": {
        "require": "./dist/axios.node.cjs",
        "default": "./dist/axios.node.js"
      },
      "react-native": {
        "require": "./dist/axios.browser.cjs",
        "default": "./dist/axios.browser.js"
      },
      "browser": {
        "require": "./dist/axios.browser.cjs",
        "default": "./dist/axios.browser.js"
      },
      "default": {
        "require": "./dist/axios.node.cjs",
        "default": "./dist/axios.node.js"
      }
    },
    "./progress": {
      "types": "./dist/progress.d.ts",
      "default": "./dist/progress.js"
    },
    "./upload": {
      "types": "./dist/upload.d.ts",
      "default": "./dist/upload.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:diff": "vitest run test/diff/runtimes",
    "test:e2e": "playwright test",
    "test:axios-suite": "npm --prefix test/axios run test",
    "size": "node scripts/size-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:release": "node --test test/release.test.mjs test/release-integration.test.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@size-limit/preset-small-lib": "14.0.1",
    "@types/node": "24.19.0",
    "axios": "1.20.0",
    "jsdom": "^30.1.2",
    "miniflare": "^4.20260730.0",
    "size-limit": "14.0.1",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "vue": "3.5.43"
  },
  "browser": {
    "./dist/axios.node.js": "./dist/axios.browser.js",
    "./dist/axios.node.cjs": "./dist/axios.browser.cjs"
  }
}
